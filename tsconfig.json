{
    "compilerOptions": {
        "jsx": "preserve",
        "jsxImportSource": "astro",
        "baseUrl": ".",
        "paths": {
            "@/*": [
                "src/*"
            ]
        },
        "strictNullChecks": true,
        "exactOptionalPropertyTypes": false,
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "allowSyntheticDefaultImports": true,
    },
    "include": [".astro/types.d.ts", "**/*"],
    "exclude": ["dist"]
}
