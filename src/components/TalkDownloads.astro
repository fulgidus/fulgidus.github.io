---
/**
 * Download links for a deck published at /talks/<slug>/, from the downloads.json
 * that scripts/build-talks.mjs writes next to it. Light and dark variants follow
 * the site theme. Rendered after the post content; a tiny inline script moves it
 * right under the deck's iframe (without JS it simply stays at the end).
 */
import fs from 'node:fs'
import path from 'node:path'

interface Props {
    src: string
    label: string
}
interface Download {
    type: string
    variant?: 'light' | 'dark'
    file: string
    name?: string
    size: number
}

const { src, label } = Astro.props
const base = src.replace(/[#?].*$/, '').replace(/\/?$/, '/')
const manifest = path.join(process.cwd(), 'public', base, 'downloads.json')
const items: Download[] = fs.existsSync(manifest) ? JSON.parse(fs.readFileSync(manifest, 'utf-8')) : []

function size(bytes: number): string {
    if (bytes < 1024) return `${bytes} B`
    if (bytes < 1024 * 1024) return `${Math.round(bytes / 1024)} KB`
    return `${(bytes / (1024 * 1024)).toFixed(1)} MB`
}
---

{items.length > 0 && (
    <div class="talk-downloads not-prose" data-talk-downloads={base}>
        <span class="talk-downloads__label">{label}:</span>
        {items.map((d) => (
            <a
                class:list={['talk-downloads__item', d.variant && `talk-downloads__item--${d.variant}`]}
                href={base + d.file}
                download={d.name ?? d.file}
            >
                {d.type.toUpperCase()} <span class="talk-downloads__size">{size(d.size)}</span>
            </a>
        ))}
        <script is:inline>
            (function () {
                var bar = document.currentScript && document.currentScript.parentElement
                if (!bar) return
                var frame = document.querySelector('article iframe[src^="' + bar.getAttribute('data-talk-downloads') + '"]')
                if (frame && frame.parentNode) frame.parentNode.insertBefore(bar, frame.nextSibling)
            })()
        </script>
    </div>
)}

<style>
    .talk-downloads {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.5rem;
        margin: 0.75rem 0 1.5rem;
        font-size: 0.85rem;
    }
    .talk-downloads__label {
        opacity: 0.7;
    }
    .talk-downloads__item {
        display: inline-flex;
        align-items: baseline;
        gap: 0.35rem;
        padding: 0.2rem 0.6rem;
        border: 1px solid currentColor;
        border-radius: 999px;
        opacity: 0.75;
        text-decoration: none;
    }
    .talk-downloads__item:hover {
        opacity: 1;
    }
    .talk-downloads__size {
        font-size: 0.75rem;
        opacity: 0.7;
    }
    :global(html:not(.dark)) .talk-downloads__item--dark,
    :global(html.dark) .talk-downloads__item--light {
        display: none;
    }
</style>
