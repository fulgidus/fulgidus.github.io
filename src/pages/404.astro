---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getActiveLanguages, getLangFromUrl, translateFrom, translatePath } from "@/i18n/utils";
import { getLastTenPosts, getHref, removeLangFromSlug } from "@/utils/posts";
import { getFormattedDate } from "@/utils/date";
import { siteConfig } from "@/site-config";
import type { Languages } from "@/i18n/ui";

// GitHub Pages serves this single 404.html for every missing path, so at build
// time Astro.url is always the default-language URL. We render the default
// language here and ship a small per-language JSON blob that the inline script
// below uses to switch the terminal to the visitor's language (from the URL).
const currentLang = getLangFromUrl(Astro.url);
const t = (key: Parameters<typeof translateFrom>[1]) => translateFrom(currentLang, key);

const dateOptions: Intl.DateTimeFormatOptions = { day: '2-digit', month: 'short', year: 'numeric' };

async function getListing(lang: Languages) {
  const recent = await getLastTenPosts({ lang });
  return recent.slice(0, 5).map((post) => ({
    href: translatePath(getHref(post), lang),
    date: getFormattedDate(post.data.pubDate, dateOptions, lang),
    name: `${removeLangFromSlug(post.slug)}/`,
  }));
}

const postsToShow = await getListing(currentLang);

const i18nData: Record<string, {
  title: string;
  error: string;
  hint: string;
  help: string;
  back: string;
  home: string;
  posts: Awaited<ReturnType<typeof getListing>>;
}> = {};
for (const lang of getActiveLanguages()) {
  i18nData[lang] = {
    title: [translateFrom(lang, '404.title'), siteConfig.title].join(' | '),
    error: translateFrom(lang, '404.terminalError'),
    hint: translateFrom(lang, '404.terminalHint'),
    help: translateFrom(lang, '404.terminalHelp'),
    back: translateFrom(lang, '404.backButtonLabel'),
    home: translatePath('/', lang),
    posts: lang === currentLang ? postsToShow : await getListing(lang),
  };
}
// Safe to inline inside <script type="application/json">
const i18nJson = JSON.stringify(i18nData).replace(/</g, '\\u003c');
---

<BaseLayout
  title={t('404.title')}
  description={t('404.description')}
>
  <div class="terminal-wrapper" role="region" aria-label="404 Error">
    <div class="terminal-titlebar">
      <div class="terminal-controls">
        <span class="terminal-dot dot-close"></span>
        <span class="terminal-dot dot-minimize"></span>
        <span class="terminal-dot dot-maximize"></span>
      </div>
      <span class="terminal-title">bash - 404</span>
      <div class="terminal-controls-spacer"></div>
    </div>
    <div class="terminal-body">
      <h1 class="sr-only">{t('404.title')}</h1>
      <div class="terminal-line">
        <span class="terminal-prompt">
          <span class="prompt-user">visitor</span><span class="prompt-at">@</span><span class="prompt-host">fulgidus.github.io</span><span class="prompt-colon">:</span><span class="prompt-path">~</span><span class="prompt-dollar">$</span>
        </span>
        <span class="terminal-command" id="typed-path"></span>
        <span class="terminal-cursor">_</span>
      </div>

      <div class="terminal-line terminal-error" data-i18n="error">{t('404.terminalError')}</div>

      <div class="terminal-line terminal-empty"></div>

      <div class="terminal-line">
        <span class="terminal-prompt">
          <span class="prompt-user">visitor</span><span class="prompt-at">@</span><span class="prompt-host">fulgidus.github.io</span><span class="prompt-colon">:</span><span class="prompt-path">~</span><span class="prompt-dollar">$</span>
        </span>
        <span class="terminal-command">ls ./posts/</span>
      </div>

      <div class="terminal-line terminal-hint">
        # <span data-i18n="hint">{t('404.terminalHint')}</span>
      </div>

      <div class="terminal-ls" id="terminal-ls">
        {postsToShow.map((post) => (
          <a href={post.href} class="terminal-file" data-astro-prefetch>
            <span class="file-permissions">-rw-r--r--</span>
            <span class="file-date">{post.date}</span>
            <span class="file-name">{post.name}</span>
          </a>
        ))}
      </div>

      <div class="terminal-line terminal-empty"></div>

      <div class="terminal-line">
        <span class="terminal-prompt">
          <span class="prompt-user">visitor</span><span class="prompt-at">@</span><span class="prompt-host">fulgidus.github.io</span><span class="prompt-colon">:</span><span class="prompt-path">~</span><span class="prompt-dollar">$</span>
        </span>
        <span class="terminal-command">cd <a href={translatePath('/', currentLang)} class="terminal-link" id="terminal-home" data-astro-prefetch>~/<span data-i18n="back">{t('404.backButtonLabel')}</span></a></span>
      </div>

      <div class="terminal-line terminal-help">
        # <span data-i18n="help">{t('404.terminalHelp')}</span>
      </div>

      <div class="terminal-line">
        <span class="terminal-prompt">
          <span class="prompt-user">visitor</span><span class="prompt-at">@</span><span class="prompt-host">fulgidus.github.io</span><span class="prompt-colon">:</span><span class="prompt-path">~</span><span class="prompt-dollar">$</span>
        </span>
        <span class="terminal-cursor blink">_</span>
      </div>
    </div>
  </div>
  <script type="application/json" id="not-found-i18n" set:html={i18nJson} />
  
  <script is:inline>
    (function () {
      // Show the attempted path in the first command
      var pathEl = document.getElementById('typed-path');
      if (pathEl) {
        pathEl.textContent = 'open ' + window.location.pathname;
      }
  
      // Switch the terminal to the language in the requested URL (e.g. /it/...).
      // Runs synchronously right after the markup, before first paint.
      var dataEl = document.getElementById('not-found-i18n');
      if (!dataEl) return;
      var data;
      try { data = JSON.parse(dataEl.textContent || '{}'); } catch (e) { return; }
      var lang = window.location.pathname.split('/')[1];
      var d = data[lang];
      if (!d || lang === document.documentElement.lang) return;
  
      document.documentElement.lang = lang;
      document.title = d.title;
      var nodes = document.querySelectorAll('[data-i18n]');
      for (var i = 0; i < nodes.length; i++) {
        var key = nodes[i].getAttribute('data-i18n');
        if (d[key]) nodes[i].textContent = d[key];
      }
      var home = document.getElementById('terminal-home');
      if (home) home.setAttribute('href', d.home);
  
      var ls = document.getElementById('terminal-ls');
      var template = ls && ls.querySelector('.terminal-file');
      if (ls && template) {
        var fragment = document.createDocumentFragment();
        d.posts.forEach(function (post) {
          var row = template.cloneNode(true);
          row.setAttribute('href', post.href);
          row.querySelector('.file-date').textContent = post.date;
          row.querySelector('.file-name').textContent = post.name;
          fragment.appendChild(row);
        });
        ls.replaceChildren(fragment);
      }
    })();
  </script>
</BaseLayout>



<style>
  .terminal-wrapper {
    max-width: 52rem;
    margin: 2rem auto;
    border-radius: 0.5rem;
    overflow: hidden;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
    font-family: 'Cascadia Code', 'Fira Code', 'JetBrains Mono', 'SF Mono', 'Consolas', 'Liberation Mono', monospace;
    font-size: 0.875rem;
    line-height: 1.6;
  }

  /* Title bar */
  .terminal-titlebar {
    display: flex;
    align-items: center;
    padding: 0.5rem 0.75rem;
    background: #2d2d2d;
    user-select: none;
  }

  :global(.dark) .terminal-titlebar {
    background: #1e1e1e;
  }

  .terminal-controls {
    display: flex;
    gap: 0.5rem;
  }

  .terminal-controls-spacer {
    width: 52px;
  }

  .terminal-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }

  .dot-close { background: #ff5f57; }
  .dot-minimize { background: #febc2e; }
  .dot-maximize { background: #28c840; }

  .terminal-title {
    flex: 1;
    text-align: center;
    color: #999;
    font-size: 0.8rem;
  }

  /* Body */
  .terminal-body {
    padding: 1rem 1.25rem;
    background: #1e1e1e;
    color: #d4d4d4;
    min-height: 20rem;
  }

  :global(html:not(.dark)) .terminal-body {
    background: #f5f5f5;
    color: #333;
  }

  /* Lines */
  .terminal-line {
    white-space: pre-wrap;
    word-break: break-all;
    margin-bottom: 0.25rem;
  }

  .terminal-empty {
    height: 1.2rem;
  }

  /* Prompt */
  .terminal-prompt {
    margin-right: 0.5rem;
  }

  .prompt-user { color: #4ec9b0; }
  .prompt-at { color: #d4d4d4; }
  .prompt-host { color: #9cdcfe; }
  .prompt-colon { color: #d4d4d4; }
  .prompt-path { color: #569cd6; }
  .prompt-dollar { color: #d4d4d4; margin-left: 0.15rem; }

  :global(html:not(.dark)) .prompt-user { color: #098658; }
  :global(html:not(.dark)) .prompt-at { color: #333; }
  :global(html:not(.dark)) .prompt-host { color: #0451a5; }
  :global(html:not(.dark)) .prompt-colon { color: #333; }
  :global(html:not(.dark)) .prompt-path { color: #0000ff; }
  :global(html:not(.dark)) .prompt-dollar { color: #333; }

  /* Command text */
  .terminal-command {
    color: #ce9178;
  }

  :global(html:not(.dark)) .terminal-command {
    color: #a31515;
  }

  /* Error */
  .terminal-error {
    color: #f44747;
    font-weight: 500;
  }

  :global(html:not(.dark)) .terminal-error {
    color: #cd3131;
  }

  /* Hint/comment lines */
  .terminal-hint,
  .terminal-help {
    color: #6a9955;
    font-style: italic;
  }

  :global(html:not(.dark)) .terminal-hint,
  :global(html:not(.dark)) .terminal-help {
    color: #008000;
  }

  /* ls file listing */
  .terminal-ls {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    margin-left: 0;
  }

  .terminal-file {
    display: flex;
    gap: 1.5rem;
    text-decoration: none;
    color: inherit;
    padding: 0.125rem 0.5rem;
    border-radius: 0.25rem;
    transition: background-color 0.15s;
  }

  .terminal-file:hover {
    background: rgba(255, 255, 255, 0.06);
  }

  :global(html:not(.dark)) .terminal-file:hover {
    background: rgba(0, 0, 0, 0.06);
  }

  .file-permissions {
    color: #858585;
    flex-shrink: 0;
  }

  :global(html:not(.dark)) .file-permissions {
    color: #999;
  }

  .file-date {
    color: #858585;
    min-width: 7.5rem;
    flex-shrink: 0;
  }

  :global(html:not(.dark)) .file-date {
    color: #999;
  }

  .file-name {
    color: #569cd6;
    font-weight: 500;
  }

  :global(html:not(.dark)) .file-name {
    color: #0451a5;
  }

  .terminal-file:hover .file-name {
    text-decoration: underline;
  }

  /* Links inside terminal */
  .terminal-link {
    color: #569cd6;
    text-decoration: none;
    font-weight: 500;
  }

  .terminal-link:hover {
    text-decoration: underline;
  }

  :global(html:not(.dark)) .terminal-link {
    color: #0451a5;
  }

  /* Cursor */
  .terminal-cursor {
    color: #d4d4d4;
  }

  :global(html:not(.dark)) .terminal-cursor {
    color: #333;
  }

  .terminal-cursor.blink {
    animation: blink 1s step-end infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  /* Responsive */
  @media (max-width: 640px) {
    .terminal-wrapper {
      margin: 1rem 0.5rem;
      font-size: 0.75rem;
    }

    .terminal-body {
      padding: 0.75rem;
    }

    .terminal-file {
      gap: 0.75rem;
    }

    .file-permissions {
      display: none;
    }

    .file-date {
      min-width: 5.5rem;
    }
  }
</style>
