---
import { fade } from "astro:transitions";
import { ClientRouter } from "astro:transitions";
import BaseHead from "@/components/BaseHead.astro";
import Header from "@/components/Header.vue";
import HeaderAstro from "@/components/Header.astro";
import Footer from "@/components/FooterComponent.vue";
import ScrollToTop from "@/components/ScrollToTop.vue";
import { getLangFromUrl, useTranslate } from "@/i18n/utils";
import { HONEYPOT_ENTRY } from "@/lib/tarpit";
import { getPageTranslations } from "@/utils/translations";
interface Props {
  title?: string;
  description?: string;
  imageSize?: string;
  image?: { src: string; alt?: string };
  ogImage?: string;
  pageType?: "website" | "article" | "profile";
  pageNav?: boolean;
  pageOperate?: boolean;
  noindex?: boolean;
  postSlug?: string;
  pubDate?: string | Date;
  tags?: string[];
  readingTime?: string;
}
const { ...head } = Astro.props;
const { imageSize, postSlug } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslate(lang);
const pageTranslations = await getPageTranslations(Astro.url, postSlug);
---

<!doctype html>
<html lang={lang}>
  <head>
    {/* Theme before anything else: the dark class and the page background are set before the first paint, without waiting for the stylesheets, so a dark page never shows the browser's white canvas (full loads, Safari/Firefox without paint holding, view transitions). The same sync runs on every client-side navigation here, not only while the header's ThemeToggle is mounted. Reads the same localStorage key that @vueuse/core useDark() uses. */}
    <style is:inline>
      html { background-color: #eef1f8; color-scheme: light; }
      html.dark { background-color: #1a1b26; color-scheme: dark; }
    </style>
    <script is:inline>
      (function () {
        function isDark() {
          var stored = null;
          try { stored = localStorage.getItem('vueuse-color-scheme'); } catch (e) {}
          return stored === 'dark' || (stored !== 'light' && window.matchMedia('(prefers-color-scheme: dark)').matches);
        }
        document.documentElement.classList.toggle('dark', isDark());
        document.addEventListener('astro:before-swap', function (e) {
          e.newDocument.documentElement.classList.toggle('dark', isDark());
        });
      })();
    </script>
    <BaseHead {...head} />
    <script is:inline>
      // Tag the page with what the browser declares itself to be (mobile or not), before first paint.
      (function () {
        function tag(doc) {
          var d = navigator.userAgentData;
          var mobile = d && typeof d.mobile === 'boolean' ? d.mobile : /Mobi/i.test(navigator.userAgent);
          doc.documentElement.classList.toggle('ua-mobile', mobile);
        }
        tag(document);
        document.addEventListener('astro:before-swap', function (e) { tag(e.newDocument); });
      })();
    </script>
    <ClientRouter />
  </head>
  <body class="bg-main text-main min-h-screen font-sans w-full bg-dot">
    <script is:inline define:vars={{ pageTranslationsJson: JSON.stringify(pageTranslations) }}>
      window.__pageTranslations__ = JSON.parse(pageTranslationsJson);
    </script>
    <script src="@/scripts/splat-decode.ts"></script>
    <a href="#main-content" class="skip-to-content">Skip to content</a>
    <Header client:only="vue" />
    <HeaderAstro />
    <main
      id="main-content"
      class=`grow ${imageSize === 'xl' ? 'max-w-100vw':'max-w-4xl'} mx-auto sm:pt-36 pt-26 pb-16 px-6 relative important:print:max-w-100vw important:print:p0 text-pretty`
      transition:animate={fade({ duration: "0.4s" })}
    >
      <slot />
      <ScrollToTop ariaLabel={t('scrollToTop.ariaLabel')} client:only="vue" />
    </main>
    <div class="max-w-4xl mx-auto sm:pt-18 pt-12 pb-16 px-6 relative">
      <Footer client:only="vue" />
    </div>
    <!-- Honeypot: invisible link to tarpit for misbehaving crawlers -->
    <a href={`/well/${HONEYPOT_ENTRY}`} style="position:absolute;left:-9999px;top:-9999px;width:1px;height:1px;overflow:hidden;" tabindex="-1" aria-hidden="true">resources</a>
  </body>
</html>
